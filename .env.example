# Optional local overrides. The regular app needs no .env file.
PORT=5000
APP_BASE_URL=http://localhost:5000
DATA_DIR=./data
MAX_UPLOAD_MB=1024
MIN_SPACING_HOURS=20

# Optional: needed for private GitHub repositories and Actions artifacts.
GITHUB_TOKEN=

# Optional: TikTok credentials may instead be entered once in the app.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://venloud.github.io/finalcog/tiktok-callback.html
