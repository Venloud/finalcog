PORT=5000
HOST=127.0.0.1
APP_BASE_URL=http://localhost:5000
DATA_DIR=./data
MAX_UPLOAD_MB=1024
MIN_SPACING_HOURS=3

# Create a TikTok Login Kit app and enable Content Posting API.
# Keep these values in your local .env file; never commit that file.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
SESSION_SECRET=

# TikTok Web Login Kit requires a registered HTTPS redirect URI.
# The existing GitHub Pages callback relays this one-time response to localhost.
TIKTOK_REDIRECT_URI=https://venloud.github.io/finalcog/tiktok-callback.html
